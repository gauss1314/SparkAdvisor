#!/usr/bin/env bash
#
# SparkAdvisor launcher.
#
# Run as root on a cluster client node. Performs the fixed Kerberos init, then
# launches the Java 8 compatible CLI. On JDK 9+ it also adds the module-open
# flags Spark 3.5.1 needs for event-log replay/reflection.
#
# Usage:
#   bin/sparkadvisor analyze --path hdfs:///.../application_xxx --statement-id <ID>
#
set -euo pipefail

# --- 1) Cluster environment + Kerberos (fixed commands per ops convention) -----
# shellcheck disable=SC1091
source /opt/client/bigdata_env
kinit -kt /opt/client/keytab/ossuser.keytab ossuser

# --- 2) Locate the fat-jar ------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_HOME="$(cd "${SCRIPT_DIR}/.." && pwd)"
JAR="${SPARKADVISOR_JAR:-${APP_HOME}/sparkadvisor-cli/target/sparkadvisor-cli.jar}"
if [[ ! -f "${JAR}" ]]; then
  echo "[sparkadvisor] CLI jar not found: ${JAR}" >&2
  echo "[sparkadvisor] Build first on a node with Maven Central access: mvn -q -DskipTests package" >&2
  exit 1
fi

# --- 3) Classpath: bundle Spark + Hadoop jars from the cluster client -----------
# Spark/Hadoop are 'provided' in the build, so supply them at runtime here.
# Prefer the env exported by bigdata_env; fall back to common locations.
SPARK_HOME="${SPARK_HOME:-/opt/client/Spark2x/spark}"
HADOOP_CONF_DIR="${HADOOP_CONF_DIR:-/opt/client/HDFS/hadoop/etc/hadoop}"
export HADOOP_CONF_DIR
HADOOP_CP=""
if command -v hadoop >/dev/null 2>&1; then
  HADOOP_CP="$(hadoop classpath --glob 2>/dev/null || hadoop classpath 2>/dev/null || true)"
fi
if [[ -n "${HADOOP_CP}" ]]; then
  CP="${JAR}:${HADOOP_CONF_DIR}:${HADOOP_CP}:${SPARK_HOME}/jars/*"
else
  CP="${JAR}:${HADOOP_CONF_DIR}:${SPARK_HOME}/jars/*"
fi

# --- 4) JVM flags ---------------------------------------------------------------
JAVA_BIN="${JAVA_HOME:+${JAVA_HOME}/bin/}java"
JAVA_VERSION_LINE="$("${JAVA_BIN}" -version 2>&1 | head -n 1)"
if [[ "${JAVA_VERSION_LINE}" =~ \"1\.([0-9]+) ]]; then
  JAVA_MAJOR="${BASH_REMATCH[1]}"
elif [[ "${JAVA_VERSION_LINE}" =~ \"([0-9]+) ]]; then
  JAVA_MAJOR="${BASH_REMATCH[1]}"
else
  JAVA_MAJOR=8
fi

JAVA_OPTS=(-Dfile.encoding=UTF-8)

# Reuse Hadoop client JVM options exported by the cluster client environment.
# These often carry required Kerberos/JAAS settings such as
# -Djava.security.krb5.conf and -Djava.security.auth.login.config. Without
# them, Java GSS/SASL may fail even when kinit and hdfs dfs work.
append_java_opts() {
  local opts="$1"
  if [[ -n "${opts}" ]]; then
    # shellcheck disable=SC2206
    local parsed=( ${opts} )
    JAVA_OPTS+=("${parsed[@]}")
  fi
}
append_java_opts "${HADOOP_OPTS:-}"
append_java_opts "${HADOOP_CLIENT_OPTS:-}"

# Spark 3.5.1 on JDK 9+ may need module opens for replay/reflection. Java 8 does
# not support --add-opens, so do not pass these flags there.
if (( JAVA_MAJOR >= 9 )); then
  JAVA_OPTS=(
    --add-opens=java.base/java.lang=ALL-UNNAMED
    --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
    --add-opens=java.base/java.nio=ALL-UNNAMED
    --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
    --add-opens=java.base/java.util=ALL-UNNAMED
    --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
    "${JAVA_OPTS[@]}"
  )
fi

exec "${JAVA_BIN}" "${JAVA_OPTS[@]}" -cp "${CP}" io.sparkadvisor.cli.SparkAdvisorCli "$@"
